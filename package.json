{
  "name": "jaco_driver_site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "PORT=3225 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "deploy:local": "next build && pm2 startOrRestart ecosystem.config.js --env local",
    "deploy:dev": "next build && pm2 startOrRestart ecosystem.config.js --env development",
    "deploy:prod": "npm update && next build && pm2 startOrRestart ecosystem.config.js --env production",
    "win": "next dev -p 3225"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "@mui/x-date-pickers": "^9.11.0",
    "@pbe/react-yandex-maps": "^1.2.5",
    "@sentry/nextjs": "^10.70.0",
    "@uiw/color-convert": "^2.10.3",
    "@uiw/react-color-alpha": "^2.10.3",
    "@uiw/react-color-wheel": "^2.10.3",
    "@yandex/smart-captcha": "^2.9.1",
    "axios": "^1.19.0",
    "dayjs": "^1.11.23",
    "firebase": "^12.17.1",
    "next": "^16.3.1",
    "query-string": "^9.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run --passWithNoTests"
    ],
    "*.{json,md,scss,css}": [
      "prettier --write"
    ]
  }
}
