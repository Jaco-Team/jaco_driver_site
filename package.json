{
  "name": "jaco_driver_site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "PORT=3225 next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "preview:offline": "NEXT_DIST_DIR=.next-preview npm run build && NEXT_DIST_DIR=.next-preview npm run start:standalone",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "deploy:local": "next build && pm2 startOrRestart ecosystem.config.js --env local",
    "deploy:dev": "next build && pm2 startOrRestart ecosystem.config.js --env development",
    "deploy:prod": "npm update && next build && pm2 startOrRestart ecosystem.config.js --env production",
    "win": "next dev -p 3225"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@pbe/react-yandex-maps": "^1.2.5",
    "@sentry/nextjs": "^11.0.0",
    "@uiw/color-convert": "^2.10.3",
    "@uiw/react-color-alpha": "^2.10.3",
    "@uiw/react-color-wheel": "^2.10.3",
    "@yandex/smart-captcha": "^2.9.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "firebase": "^12.19.0",
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.6",
    "query-string": "^9.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.0",
    "sharp": "^0.35.4",
    "use-sync-external-store": "^1.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run --passWithNoTests"
    ],
    "*.{json,md,scss,css}": [
      "prettier --write"
    ]
  }
}
