{
  "name": "jaco_driver_site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PORT=3225 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "deploy:local": "next build && pm2 startOrRestart ecosystem.config.js --env local",
    "deploy:dev": "next build && pm2 startOrRestart ecosystem.config.js --env development",
    "deploy:prod": "npm update && next build && pm2 startOrRestart ecosystem.config.js --env production",
    "win": "next dev -p 3225"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^9.0.1",
    "@mui/x-date-pickers": "^8.28.5",
    "@pbe/react-yandex-maps": "^1.2.5",
    "@sentry/nextjs": "^10.53.1",
    "@sentry/react": "^10.53.1",
    "@uiw/color-convert": "^2.10.1",
    "@uiw/react-color-alpha": "^2.10.1",
    "@uiw/react-color-wheel": "^2.10.1",
    "axios": "^1.16.0",
    "dayjs": "^1.11.20",
    "firebase": "^12.13.0",
    "mui-file-dropzone": "^4.0.2",
    "next": "^16.2.6",
    "query-string": "^9.3.1",
    "react": "^19.2.6",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.6",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-color": "^3.0.13",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,css}": [
      "prettier --write"
    ]
  }
}
