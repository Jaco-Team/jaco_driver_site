{
  "name": "jaco_driver_site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "browserslist": {
    "production": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 111",
      "safari >= 16.4",
      "ios_saf >= 16.4"
    ],
    "development": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 111",
      "safari >= 16.4",
      "ios_saf >= 16.4"
    ]
  },
  "scripts": {
    "sync:offline-map": "node scripts/sync-offline-map-runtime.mjs",
    "predev": "npm run sync:offline-map",
    "dev": "PORT=3225 next dev",
    "prebuild": "npm run sync:offline-map",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "preview:offline": "NEXT_DIST_DIR=.next-preview npm run build && NEXT_DIST_DIR=.next-preview npm run start:standalone",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "deploy:local": "npm run build && pm2 startOrRestart ecosystem.config.js --env local",
    "deploy:dev": "npm run build && pm2 startOrRestart ecosystem.config.js --env development",
    "deploy:prod": "npm update && npm run build && pm2 startOrRestart ecosystem.config.js --env production",
    "prewin": "npm run sync:offline-map",
    "win": "next dev -p 3225"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@pbe/react-yandex-maps": "^1.2.5",
    "@sentry/nextjs": "^11.4.0",
    "@uiw/color-convert": "^2.10.3",
    "@uiw/react-color-alpha": "^2.10.3",
    "@uiw/react-color-wheel": "^2.10.3",
    "@yandex/smart-captcha": "^2.9.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "firebase": "^12.19.0",
    "maplibre-gl": "^6.12.0",
    "next": "^16.3.8",
    "query-string": "^9.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "use-sync-external-store": "^1.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "source-map-js": "1.2.2",
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run --passWithNoTests"
    ],
    "*.{json,md,scss,css}": [
      "prettier --write"
    ]
  }
}
